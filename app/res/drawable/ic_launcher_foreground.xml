<?xml version="1.0" encoding="utf-8"?>
<!-- App pointer icon, 512x512 artwork.
     The 512 box is mapped onto the 72dp visible area of the 108dp adaptive-icon
     canvas, so the viewport is 768 wide and the art is offset by 128. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="768"
    android:viewportHeight="768">
    <group android:translateX="128" android:translateY="128">
        <path
            android:pathData="M256,96 L394,418 L256,346 L118,418 Z"
            android:fillColor="#FF7A2F"
            android:strokeColor="#FF7A2F"
            android:strokeWidth="24"
            android:strokeLineJoin="round" />
    </group>
</vector>
